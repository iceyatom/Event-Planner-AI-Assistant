# Server-only. Enter secrets privately; never prefix them NEXT_PUBLIC_.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
CHAT_ENABLED=false
DEMO_MODE=true
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Generate privately: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
IP_HASH_SECRET=
DAILY_REQUEST_LIMIT=100
MONTHLY_REQUEST_LIMIT=500
# Sliding window shared by everyone behind one school IP.
IP_BURST_LIMIT=30
IP_BURST_WINDOW_SECONDS=60
# Blank blocks cross-origin framing. Setting https://sites.google.com also
# allows Google's gstatic and changing googleusercontent.com embed wrappers.
FRAME_ANCESTORS=
